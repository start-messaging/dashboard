# The API listens on 3001 (server/.env PORT), not Nest's 3000 default.
VITE_API_BASE_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# PostHog project API key — empty = analytics and session replay off
VITE_POSTHOG_KEY=
# PostHog ingestion host — only used when VITE_POSTHOG_KEY is set
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Sentry DSN for error reporting — empty = off
VITE_SENTRY_DSN=
